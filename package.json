{
  "name": "sessionary",
  "version": "1.0.0",
  "description": "Local-first AI coding session ledger for Codex and Claude Code sessions.",
  "license": "ISC",
  "author": "qmkCamel",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "openspec:list": "openspec list --json",
    "openspec:status": "openspec list --json",
    "openspec:validate": "openspec validate --all --strict",
    "openspec:validate:changes": "openspec validate --changes --strict",
    "test": "npm run test:web && npm run test:rust",
    "test:web": "vitest run",
    "test:rust": "cd src-tauri && cargo test",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.3.1",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.2",
    "vitest": "^4.1.7"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qmkCamel/sessionary.git"
  },
  "keywords": [
    "ai-coding",
    "codex",
    "claude-code",
    "local-first",
    "session-ledger",
    "tauri"
  ],
  "bugs": {
    "url": "https://github.com/qmkCamel/sessionary/issues"
  },
  "homepage": "https://github.com/qmkCamel/sessionary#readme"
}
